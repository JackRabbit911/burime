<!doctype html>
<html lang="{{ i18n.lang()|default('en') }}" class="h-full">
<head>
  {{ include('common/head.twig') }}
  <script src="/assets/js/themeSet.js"></script>
</head>
<body class="h-full">
  <div class="mx-auto flex flex-col min-h-screen">
    <div class="lg:container lg:mx-auto">
      <a href="{{ app.env('APP_MAIN_URL') }}" class="btn btn-ghost text-xl mt-0.5">buri.me</a>
    </div>
    {{ app.cmp('navbar')|raw }}
    {% block main %}
    {% endblock %}
    {{ include('common/footer.twig') }}
  </div>
  <script src="/assets/js/themeToggle.js"></script>
  <script src="/assets/js/informer.js"></script>
  {{ app.js|raw }}
</body>
</html>
