{% if app.user %}
<a href="{{ path('my') }}">
  <div tabindex="0" role="button" class="btn btn-ghost indicator h-13 px-0">
    <div id="username" class="w-32 lg:w-full text-xs text-base-content/80">
      {{ app.user.name }}
    </div>
    <div id="user_avatar" class="avatar">
      <div class="size-14 rounded">
        <img src="{{ path('avatar', {action: 'user', id: app.user.id}) }}" alt="{{ app.user.name }}" />
      </div>
    </div>
  </div>
</a>
{% else %}
<a href="{{ path('auth', {action: 'form'}) }}" class="mt-1.4">
  <div tabindex="0" role="button" class="btn btn-square btn-ghost">
    {{ svg('hi_login') }}
  </div>
</a>
{% endif %}
