<div class="dropdown dropdown-end mt-1.4">
    <div tabindex="0" role="button" class="btn btn-square btn-ghost">
      {{ svg('hi_language') }}
    </div>
    <ul tabindex="0" class="dropdown-content menu bg-base-100 max-h-[70vh] overflow-y-auto rounded-box z-50 min-w-38 p-2 mt-4 shadow-sm">
      {% for lang, title in i18n.linksList(app.request.path) %}
        <li>
          <a href="{{ lang }}">
            {{ title }}
          </a>
        </li>
      {% endfor %}
    </ul>
</div>
