{% if p.countRows > p.limit %}

{% if p.isFirst %}
{% set disabled_left = ' disabled' %}
{% else %}
{% set disabled_left = '' %}
{% endif %}

{% if p.isLast %}
{% set disabled_right = ' disabled' %}
{% else %}
{% set disabled_right = '' %}
{% endif %}

<div class="join">
  <a href="{{ p.first }}" class="join-item btn btn-sm" {{ disabled_left }}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
      class="size-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m18.75 4.5-7.5 7.5 7.5 7.5m-6-15L5.25 12l7.5 7.5" />
    </svg>
  </a>
  <a href="{{ p.prev() }}" class="join-item btn btn-sm" {{ disabled_left }}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
      class="size-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
  </a>
  <button class="join-item btn btn-sm text-xl btn-primary">
    {{ p.currentPage }}
  </button>
  <a href="{{ p.next() }}" class="join-item btn btn-sm" {{ disabled_right }}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
      class="size-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
    </svg>
  </a>
  <a href="{{ p.last }}" class="join-item btn btn-sm" {{ disabled_right }}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
      class="size-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5" />
    </svg>
  </a>
</div>

{% endif %}
