<div class="w-full flex flex-row">
  <div class="avatar aspect-square size-24">
    <img src="{{ author.avatar }}" />
  </div>
  <div class="max-w-full overflow-hidden text-start ps-3">
    <h1 class="max-w-full text-balance overflow-hidden text-ellipsis text-2xl">
      {{ author.alias }}
    </h1>
    <p class="text-sm italic overflow-hidden">
      {{ author.info.slogan ?? '...' }}
    </p>
  </div>
</div>
