{% extends 'common/container_md.twig' %}
{% block content %}
<h1 class="text-2xl md:text-3xl my-3">{{ title }}</h1>
<div class="my-2 flex justify-between pb-2">
  <a href="/my/branch" class="btn btn-primary dark:btn-info w-4/5 sm:w-2/3">
    {{ __('Create a new work') }}
  </a>
</div>
<div class="my-2 flex justify-between">
  <a href="" class="btn btn-primary dark:btn-info w-4/5 sm:w-2/3">
    {{ __('Create a branch from an existing work') }}
  </a>
   <div class="stat-value text-primary dark:text-info">{{ count.total }}</div>
</div>
<div class="my-2 flex justify-between">
  <a href="" class="btn btn-primary dark:btn-info w-4/5 sm:w-2/3">
    {{ __('Take part in an existing project') }}
  </a>
   <div class="stat-value text-primary dark:text-info">{{ count.open }}</div>
</div>
{% endblock %}
