{% extends 'common/container_md.twig' %}
{% block content %}
    <h1 class="text-2xl md:text-3xl font-medium my-3">{{ __(title) }}</h1>
    <div class="text-center text-medium">
        {{ __('First of all,') }}
        {{ __('You need to') }}
        <div class="text-center my-2">
            <a href="{{ path('auth') }}" class="btn btn-primary dark:btn-info w-full md:w-2/3">
                {{ __('Log In') }}
            </a>
        </div>
        {{ __('or') }}
        <div class="text-center my-2">
            <a href="/auth/register" class="btn btn-primary dark:btn-info w-full md:w-2/3">
                {{ __('Sign Up, please:') }}
            </a>
        </div>
        {{ __('to our website') }}
        <div class="text-sm text-base-content">
            Для чего это нужно:
        </div>
    </div>
{% endblock %}
