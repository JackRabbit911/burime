{% macro avatar(author) %}
<div class="avatar aspect-square">
    <img src="{{ author.avatar }}" alt="{{ author.alias }}" />
</div>
{% endmacro %}

{% macro authorinfo(author) %}
<div class="p-1 pt-2.5 flex flex-row justify-center items-center">
    {{ svg('lucide-star', {class: 'size-5 text-warning'}) }}
    <span class="badge badge-ghost me-1">{{ author.rate ?? 4.5 }}</span>
    {{ svg('lucide-bookmark', {class: 'size-5 text-primary'}) }}
    <span class="badge badge-ghost me-1">{{ author.favorites ?? 10 }}</span>
    {{ svg('lucide-message-square-text', {class: 'size-5'}) }}
    <span class="badge badge-ghost me-1">{{ author.posts ?? 34 }}</span>
    {{ svg('lucide-git-branch', {class: 'size-5 text-info'}) }}
    <span class="badge badge-ghost">{{ author.branch ?? 1 }}</span>
    {% if author.openclosed < 1 %}
        {% if author.c_members> 0 %}
        {{ svg('lucide-users', {class: 'size-5 text-primary'}) }}
        <span class="badge badge-ghost me-1">{{ author.c_members }}</span>
        {% else %}
            {{ svg('lucide-lock-open', {class: 'size-5 text-success'}) }}
        {% endif %}
    {% elseif author.openclosed == 1 %}
        {{ svg('lucide-lock', {class: 'size-5 text-error'}) }}
    {% endif %}
</div>
{% endmacro %}

{% macro authorcard(author) %}
<a href="{{ path('author', {'id': author.id}) }}">
    <div class="aspect-2.5/1 flex flex-col shadow-md hover:shadow-xl rounded">
        <div class="flex flex-row justify-between h-4/5">
            {{ _self.avatar(author) }}
            <div class="grow overflow-hidden px-2 pt-1">
                <h2 class="text-xl font-medium">{{ author.alias }}</h2>
                <p class="text-balance italic">
                    {{ author.info.slogan ?? '...' }}
                </p>
            </div>
        </div>
        {{ _self.authorinfo(author) }}
    </div>
</a>
{% endmacro %}
