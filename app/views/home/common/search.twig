<input
  type="hidden"
  name="show"
  value="{{ show }}"
/>
<input
  type="search"
  name="search"
  placeholder="{{ __(placeholder) }}"
  class="input input-bordered rounded-none input-sm join-item w-full join-item"
  value="{{ search }}"
/>
<button type="submit" class="btn border border-zinc-600 btn-sm rounded-r-sm border-l-0 join-item">
  <svg xmlns="http://w3.org" viewBox="0 0 16 16" fill="currentColor" class="h-5 w-5 opacity-70">
    <path fill-rule="evenodd"
      d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z"
      clip-rule="evenodd" />
  </svg>
</button>
<a href="{{ reset }}" class="btn border border-zinc-600 btn-sm rounded-r-sm border-l-0 join-item">
  X
</a>
