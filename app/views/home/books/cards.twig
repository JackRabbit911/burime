{% extends 'common/container.twig' %}
{% block content %}
{{ include('common/title_switcher.twig') }}
<div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-6 gap-4 mt-4 h-auto">
  {% import 'home/books/book_card.twig' as b %}
  {% for book in books %}
  <a href="{{ path('branch', {'branch_id': book.id}) }}">
    {{ b.book(book) }}
  </a>
  {% endfor %}
</div>
{% endblock %}
