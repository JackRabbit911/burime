{% macro alert(data) %}
{% if data.role == 'info' %}
{% set class = 'alert-info' %}
{% elseif data.role == 'success' %}
{% set class = 'alert-success' %}
{% elseif data.role == 'warning' %}
{% set class = 'alert-warning' %}
{% elseif data.role == 'error' %}
{% set class = 'alert-error' %}
{% elseif data.role == 'info-soft' %}
{% set class = 'alert-info alert-soft' %}
{% elseif data.role == 'success-soft' %}
{% set class = 'alert-success alert-soft' %}
{% elseif data.role == 'warning-soft' %}
{% set class = 'alert-warning alert-soft' %}
{% elseif data.role == 'error-soft' %}
{% set class = 'alert-error alert-soft' %}
{% else %}
{% set class = 'alert' %}
{% endif %}

{% set icon = data.role|split('-')[0] %}

<div role="alert" class="alert {{ class }} rounded-none sm:rounded-lg">
    {{ _self.icon(icon) }}
    <div>
        <h3 class="text-lg font-medium">
            {{ __(data.subject) }}
        </h3>
        {% if data.appeal is defined %}
            <h4 class="text-md font-bold">
                {{ __(data.appeal, {username: data.username}) }}
            </h4>
        {% endif %}
        <p>
            {{ __(data.msg) }} 
            {% if data.link is defined %}
            <a href="{{ data.link.href }}" class="link font-semibold">
                {{ __(data.link.title) }}
            </a>
            {% endif %}
        </p>
    </div>
    {% if data.btn is defined %}
    <a href="{{ data.btn.href }}" class="btn btn-neutral">{{ __(data.btn.title) }}</a>
    {% endif %}
</div>
{% endmacro %}

{% macro icon(icon) %}
{% if icon == 'info' %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
</svg>
{% elseif icon == 'success' %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
</svg>
{% elseif icon == 'warning' %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
</svg>
{% elseif icon == 'error' %}
<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
</svg>
{% else %}
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
</svg>
{% endif %}
{% endmacro %}
