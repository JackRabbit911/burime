    stroke="currentColor" class="{{ size }} {{ color }} fill-current">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
{% endmacro %}

{% macro check(size = 'size-6', color = 'green') %}
