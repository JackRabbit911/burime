{% macro menu(menu) %}
    {% for item in menu %}
        <li>
            {% if item.sub is defined %}
                {% if app.is_active(item.title, false) %}
                    {% set active = ' class=menu-active' %}
                {% else %}
                    {% set active = '' %}
                {% endif %}
                <details>
                    <summary>
                        <a{{ active }}>
                            {{ __(item.title) }}
                        </a>                            
                    </summary>
                    <ul class="md:w-52">
                        {{ _self.menu(item.sub) }}
                    </ul>
                </details>
            {% else %}
                {% if app.is_active(item.href) %}
                    {% set active = ' class=menu-active' %}
                {% else %}
                    {% set active = '' %}
                {% endif %}
                <a{{ active }} href="{{ item.href }}">
                    {{ __(item.title) }}
                </a>
            {% endif %}            
        </li>
    {% endfor %}
{% endmacro %}
