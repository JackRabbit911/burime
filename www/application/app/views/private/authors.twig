{% import 'home/authors/author_card.twig' as a %}
<div class="flex flex-row justify-between">
    <h4 class="grow mt-2 text-lg font-medium leading-9 tracking-tight text-nowrap">
        {{ __('My authors and groups') }}
    </h4>
    <a href="{{ path('author.form', {'action': 'form'}) }}"
        class="mt-3.5 link link-primary text-end">
        {{ __('Create a new author/group') }}
    </a>
</div>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4 h-auto">
    {% for author in authors %}    
        {{ a.authorcard(author) }}
    {% endfor %}
</div>
