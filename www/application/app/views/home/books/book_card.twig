{% macro book(book) %}
{% set bg_color = book.info.bg_color ?? '#eeeeee' %}
{% set text_color = book.info.text_color ?? '#333333' %}
{% set style = 'style="background-color: ' ~  bg_color ~ '; color: ' ~ text_color ~ ';"' %}
{% if book.status and book.status < 100 %}
{% set opacity = ' opacity-50 ' %}
{% else %}
{% set opacity = ' ' %}
{% endif %}
<div class="border border-neutral-content bg-cover aspect-2/3{{ opacity }}
flex flex-col justify-between text-center shadow overflow-hidden" {{ style|raw }}>
{% if book.cover is defined and book.cover %}
<img src="{{ '/img/cover/' ~ book.cover }}" alt="{{ book.title }}" />
{% else %}
    <div class="text-sm flex-none overflow-hidden p-1">
        {{ book.alias ?? '' }}
    </div>
    <div class="text-xl md:text-xl lg:text-base 2xl:text-xl overflow-hidden p-1">
        {{ book.title }}
    </div>
    <div class="text-xs flex-none overflow-hidden p-1">
        {{ book.genreStr }}
    </div>
{% endif %}
</div>
{% endmacro %}

