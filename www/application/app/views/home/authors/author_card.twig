{% macro avatar(author) %}
<div class="avatar aspect-square">
    <img src="{{ author.avatar }}" />
</div>
{% endmacro %}

{% macro authorinfo(author) %}
<div class="p-1 pt-2.5 flex flex-row justify-center items-center">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-warning">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
    </svg>
    <span class="badge badge-ghost me-1">{{ author.rate ?? 4.5 }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-primary">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
    </svg>                  
    <span class="badge badge-ghost me-1">{{ author.favorites ?? 10 }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
    </svg>
    <span class="badge badge-ghost me-1">{{ author.posts ?? 34 }}</span>
    <svg class="size-4 text-info" width="16" height="16" viewBox="0 0 225 195" fill="none" xmlns="http://www.w3.org/2000/svg" fill="none">
        <circle cx="193" cy="27" r="25" stroke="currentColor" stroke-width="14"/>
        <circle cx="29" cy="27" r="25" stroke="currentColor" stroke-width="14"/>
        <circle cx="193" cy="168" r="25" stroke="currentColor" stroke-width="14"/>
        <path d="M53 27.5C91.5 29.5001 107.5 38 107.5 105C107.5 167.5 155 167.5 167 167.5" stroke="currentColor" 
        stroke-width="14"/>
        <path d="M51.4856 27.4747H165.58" stroke="currentColor" stroke-width="14" stroke-linecap="round"/>
    </svg>
    <span class="badge badge-ghost">{{ author.branch ?? 1 }}</span>
    {% if author.openclosed < 1 %}
        {% if author.c_members > 0 %}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
        <span class="badge badge-ghost me-1">{{ author.c_members }}</span>
        {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-success">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
        {% endif %}
    {% elseif  author.openclosed == 1 %}
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 text-error">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
    </svg>
    {% endif %}    
</div>
{% endmacro %}

{% macro authorcard(author) %}
<a href="{{ path('author', {'id': author.id}) }}">
    <div class="aspect-[2.5/1] flex flex-col shadow-md hover:shadow-xl rounded">
        <div class="flex flex-row justify-between h-4/5">
            {{ _self.avatar(author) }}
            <div class="grow overflow-hidden px-2 pt-1">
                <h2 class="text-xl font-medium">{{ author.alias }}</h2>
                <p class="text-balance italic">
                    {{ author.info.slogan ?? '...' }}
                </p>
            </div>
        </div>
        {{ _self.authorinfo(author) }}   
    </div>
</a>
{% endmacro %}
