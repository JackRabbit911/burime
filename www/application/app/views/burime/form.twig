{% embed 'burime/branch.twig' %}
{% block right %}
{% import 'common/macro/formmacro.twig' as m %}
<article>
    <p class="mb-3">{{ last.body ?? '' }}</p>
    {{ include('burime/timer.twig') }}
    <form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
            {{ m.textarea(new_post) }}
        <div class="flex flex-col lg:flex-row lg:justify-between">
            <div class="grow lg:me-2 mt-2">
                {% if macros == 'select' %}
                    {{ m.select(author) }}
                {% else %}
                    {{ m.input(author) }}
                {% endif %}
            </div>
            <div class="grid grid-cols-3 gap-2 mt-2">
                <button form="{{ form.id }}" name="sbmt" type="submit" class="btn btn-error" value="cancel">
                    {{ __('Cancel') }}
                </button>
                <button form="{{ form.id }}" name="sbmt" type="submit" class="btn" value="draft">
                    {{ __('Draft') }}
                </button>
                <button form="{{ form.id }}" name="sbmt" type="submit" class="btn btn-primary" value="publish">
                    {{ __('Publish') }}
                </button>
            </div>
        </div>
    </form>
</article>
{% endblock right %}
{% endembed %}
