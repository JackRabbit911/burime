<div class="flex flex-row justify-between">
    {% if postPermissions.timer() %}
    {% set hour = 'style=--value:' ~ hour ~ ';' %}
    {% set min = 'style=--value:' ~ min ~ ';' %}
    {% set sec = 'style=--value:' ~ sec ~ ';' %}
        <span
            id="timeLimitCounter"
            class="countdown font-mono text-xl"
            data-time="{{ timeRemaining }}"
        >
            <span id="hours" {{ hour }}></span>
            :
            <span id="min" {{ min }}></span>
            :
            <span id="sec" {{ sec }}></span>
        </span>
    {% else %}
        <span></span>
    {% endif %}
    <span class="pb-1 text-error">{{ msg ?? '' }}</span>
</div>
