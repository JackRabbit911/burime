<div class="flex flex-row justify-between">
    {% if postPermissions.timer() %}
        <span
            class="countdown font-mono text-xl"
            data-time="{{ branch.info.time_limit }}"
            data-id="{{ post.id }}"
        >
            <span id="hours" style="--value:0;"></span>
            :
            <span id="min" style="--value:0;"></span>
            :
            <span id="sec" style="--value:0;"></span>
        </span>
    {% else %}
        <span></span>
    {% endif %}
    <span class="pb-1 text-error">{{ msg }}</span>
</div>
