{% import 'web/macro/formmacro.twig' as m %}
<form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ m.select(author) }}
    <div class="flex flex-row justify-end mt-3">
        <button form="{{ form.id }}" type="submit" class="btn btn-primary w-full md:w-1/2">
            {{ __('Ask to join') }}
        </button>
    </div>
</form>
