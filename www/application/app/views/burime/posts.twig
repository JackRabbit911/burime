{% embed 'burime/branch.twig' %}
{% block right %}
{% if perms.age %}
<article class="text-current/80">
    {% if app.postPermissions.first() %}
        <a title="Write fist post" href="{{ path('branch', {'branch_id': branch.id, 'action': 'form'}) }}" class="cursor-pointer btn btn-primary w-full">
            {{ __('Wtite the first post') }}
        </a>
    {% endif %}
    {% set last_author = null %}
    {% for post in posts %}
        {% if app.postPermissions.show(post) %}
            {% if post.status < 100 %}
            <span class="countdown font-mono text-xl -mb-8 mt-4">
                <span style="--value:10;"></span>
                :
                <span style="--value:24;"></span>
                :
                <span style="--value:${counter};"></span>
            </span>
            {% if post.status == 80 %}
                {% set msg = __('Under moderation') %}
            {% elseif post.status == 10 %}
                {% set msg = __('You didn`t have time to publish the post') %}
            {% else %}
                {% set msg = '' %}
            {% endif %}
            <span class="ms-4 text-error">{{ app.session.msg ?? msg }}</span>
            <p class="bg-neutral text-neutral-content">
                    {{ post.body|nl2br|raw }}
                </p>
            {% else %}
                <p>{{ post.body|nl2br|raw }}</p>
            {% endif %}
            <div class="flex flex-row justify-between prose max-w-none mt-2 mb-4">              
                {{ app.PostControls.render(post)|raw }}
            </div>
            {% set last_author = post.author_id %}
        {% endif %}
    {% endfor %}
    {% if app.postPermissions.newPost(last_author) %}   
        <a title="Write post" href="{{ path('branch', {'branch_id': branch.id, 'action': 'form'}) }}" class="cursor-pointer btn btn-primary w-full">
            {{ __('Wtite the post') }}
        </a>
    {% endif %}
    {% if last %}
        <p class="opacity-50">{{ last.body|nl2br|raw }}</p>
    {% endif %}
</article>
{% else %}
<div class="p-10 text-center h-full bg-warning text-lg align-middle">
    {{ __(perms.msg)|raw }}
</div>
{% endif %}
{% endblock right %}
{% endembed %}
