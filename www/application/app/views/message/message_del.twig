{% extends 'common/layout.twig' %}
{% import 'message/tr_msg_macro.twig' as tr %}
{% block content %}
<div class="flex min-h-full flex-col justify-center px-2 py-6 lg:px-4">
    <h2 class="mt-10 text-center text-2xl font-bold leading-9 tracking-tight">{{ title }}</h2>
        
    <div class="mx-auto w-full md:w-2/3 lg:w-1/2 grid md:grid-cols-3 gap-4">
        <div>
            <p class="label-text py-2">{{ __('From') }}</p>
            <a href="{{ path('author', {'id': msg.from}) }}" class="link">
                <div class="flex">
                    <div class="avatar">
                        <div class="mask mask-squircle h-14 w-14">
                            <img src="{{ app.avatar(msg.from) }}" alt="{{ msg.alias }}" />
                        </div>
                    </div>
                    <div class="grow flex justify-center">
                        {{ msg.alias }}
                    </div>
                </div>
            </a>
        </div>
        <div class="md:col-span-2">
            <p class="label-text py-2">{{ __('Subject') }}</p>
            <p class="border rounded-lg p-6">{{ msg.subject }}</p>
            <p class="label-text py-2">{{ __('Message') }}</p>
            <p class="border rounded-lg p-6">
                {{ msg.data.body }}
            </p>
        </div>
        
        <div class="md:col-span-3 flex flex-row justify-center">
            <a href="{{ path('message', {'action': 'list'}) }}" class="btn me-2">
                {{ __('Go to messages list') }}
            </a>
            <a href="{{ path('message', {'action': 'remove', 'id': msg.id, 'author_id': msg.from})}}" class="btn me-2">
                {{ __('Delete') }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
