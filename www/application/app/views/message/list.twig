{% embed 'common/embed/top-xl.twig' %}
{% import 'message/tr_msg_macro.twig' as tr %}
{% block top %}
    <h1 class="text-center text-2xl font-bold leading-9 tracking-tight">{{ __(title) }}</h1>
{% endblock top %}
{% block center %}
    <a href="{{ path('message', {'action': 'form'}) ~ '?new=true' }}" class="btn btn-primary btn-sm mb-3">
        {{ __('New message') }}
    </a>
    <div class="overflow-x-auto">
        {% if inbox is not empty %}
        <h4>Inbox</h4>
        <table class="table">
            <thead>
                <tr>
                <th>Status</th>
                <th>Date</th>
                <th>From</th>
                <th>To</th>
                <th>Subject</th>
                </tr>
            </thead>
            <tbody>
            {% for msg in inbox %}
                {{ tr.tr_in(msg) }}
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if outbox is not empty %}
        <h4>Outbox</h4>
        <table class="table">
            <thead>
                <tr>
                <th>Status</th>
                <th>Date</th>
                <th>From</th>
                <th>To</th>
                <th>Subject</th>
                </tr>
            </thead>
            <tbody>
            {% for msg in outbox %}
                {{ tr.tr_out(msg) }}
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if deleted is not empty %}
        <h4>Deleted</h4>
        <table class="table">
            <thead>
                <tr>
                <th>From</th>
                <th>Subject</th>
                <th></th>
                </tr>
            </thead>
            <tbody>
            {% for msg in deleted %}
                {{ tr.tr_del(msg) }}
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
{% endblock center %}
{% endembed %}
