{% embed 'branch/edit/form_wrapper.twig' %}
{% block center %}
<div role="tablist" class="tabs tabs-lift w-full">
    <a href="{{ path('edit', {'action': 'genres', 'id': branch.id}) }}" role="tab" class="tab">{{ __('Genres') }}</a>
    <a href="{{ path('edit', {'action': 'rules', 'id': branch.id}) }}" role="tab" class="tab">{{ __('Rules') }}</a>
    <a role="tab" class="tab tab-active">{{ __('Authors') }}</a>
    <div role="tabpanel" class="w-full tab-content border-base-300 rounded-btn p-6">
        {{ form|raw }}
    </div>
    <a href="{{ path('edit', {'action': 'cover', 'id': branch.id}) }}" role="tab" class="tab">{{ __('Cover') }}</a>
    <a href="{{ path('edit', {'action': 'publish', 'id': branch.id}) }}" role="tab" class="tab">{{ __('Publish') }}</a>
</div>
{% endblock center %}
{% endembed %}
