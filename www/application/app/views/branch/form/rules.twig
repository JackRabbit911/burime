{% import 'common/macro/formmacro.twig' as m %}

{% macro number(attr) %}
<div class="flex flex-row justify-between my-2">
    <label class="fieldset-label cursor-pointer">
        <legend class="fieldset-legend pb-1.5 pt-0">
            {{ attr.label }}
        </legend>
        {{ attr.alt_label ?? '' }}
    </label>   
    <input name="{{ attr.name }}" class="input input-bordered input-sm w-24"
    type="number" value="{{ attr.value ?? null }}" min="{{ attr.min }}" max="{{ attr.max }}" step="{{ attr.step }}" />
</div>
{% endmacro number %}

<form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    <fieldset class="fieldset">
        <div class="grid md:grid-cols-3 gap-4">
            <div>
                <legend class="fieldset-legend ms-0 mx-1 mb-2">
                    {{ role.label }}
                </legend>
                {{ m.radio(role, 'Open', 0) }}
                {{ m.radio(role, 'Closed', 1) }}
                {{ m.radio(role, 'Commercial', 2) }}
                <div class="divider my-1"></div>   
                {{ m.checkbox(info.moderation) }}
                {{ m.checkbox(info.comments) }}
                {{ m.checkbox(info.signature) }}    
                {{ _self.number(age_limit) }}
                {{ _self.number(info.post_size) }}
                {{ _self.number(info.time_limit) }}
            </div>
            <div class="md:col-span-2">
                {{ m.input(title) }}
                {{ m.textarea(info.description) }}
                {{ m.textarea(info.rules) }}
            </div>        
        </div>
    </fieldset>
</form>
