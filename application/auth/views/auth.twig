{% embed '@auth/common/center_wrapper.twig' %}
{% block center %}
{% import 'common/macro/formmacro.twig' as m %}
<form id="{{ form.id }}" method="post" action="{{ form.action }}" accept-charset="UTF-8" enctype="multipart/form-data">
    <fieldset class="fieldset w-full bg-base-200 border border-base-300 p-4 rounded-box">
        <h1 class="text-2xl font-medium leading-9 tracking-tight my-4">
            {{ __(title) }}
        </h1>
        {{ csrf()|raw }}
        {{ m.input(email) }}
        {{ m.input(password) }}
        <div class="flex flex-row justify-between">
            {{ m.checkbox(remember) }}
            <div class="mt-1">
                <a href="{{ path('restore', {'action': 'form'}) }}" class="link">
                    {{ __('Forgot password?') }}
                </a>
            </div>
        </div>
        <button class="btn btn-primary mt-4">{{ __('Sign In') }}</button>
        <p class="mt-5 text-end text-sm">
            {{ __('Not a member?') }}
            <a href="{{ path('register', {'action': 'form'}) }}" class="link-hover font-semibold mx-2">
                {{ __('Sign Up, please:') }}
            </a>
        </p>
    </fieldset>
</form>
{% endblock %}
{% endembed %}
