{% import 'common/macro/formmacro.twig' as m %}
<form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    <fieldset class="fieldset">
        <div class="grid md:grid-cols-2 gap-4">
            <div class="overflow-x-auto">
                <table>
                    <thead>
                        <tr>
                            <td>
                                <label for="sendmsg" class="fieldset-label flex justify-between mb-4">
                                    <legend class="fieldset-legend">
                                        {{ __('Send message') }}
                                    </legend>
                                    <input id="sendmsg" 
                                    type="checkbox" class="checkbox" />
                                </label>
                            </td>
                        </tr>
                    </thead>
                    <tbody class="overflow-auto">
                        {% for author in authors %}
                        <tr>
                            <td>
                                {{ m.checkbox(author) }}
                            </td>
                        </tr>                    
                        {% endfor %}
                    </tbody>
                </table>           
            </div>
            <div>
                <legend class="fieldset-legend mb-4">
                    {{ __(status.label) }}
                </legend>
                {{ m.radio(status, 'Ready', 150) }}
                {{ m.radio(status, 'Blocked', 120) }}
                {{ m.radio(status, 'Closed', 110) }}
                {{ m.radio(status, 'Draft', 20) }}
                {{ m.radio(status, 'Deleted', 0) }}
            </div>
        </div>
    </fieldset>
</form>
