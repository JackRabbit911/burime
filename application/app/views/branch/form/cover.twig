{% import 'common/macro/formmacro.twig' as m %}
{% import 'home/books/book_card.twig' as b %}

{% macro color(attr) %}
<legend class="fieldset-legend">
    {{ attr.label }}
</legend>
<input name="{{ attr.name }}" id="{{ attr.id }}" type="color"
class="input input-bordered input-md w-14 p-1" value="{{ attr.value ?? '' }}" />
{% endmacro color %}

<form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    <fieldset class="fieldset">
        <div class="grid md:grid-cols-3 gap-4">
            <div>
                <legend class="fieldset-legend mb-3">
                    {{ __('Cover') }}
                </legend>
                <div class="pe-3">
                    {{ b.book(branch) }}
                </div>
            </div>
            <div class="md:col-span-2">
                <legend class="fieldset-legend mb-3">
                    {{ __('Choose colors') }}
                </legend>
                <div class="flex flex-row justify-around">
                    <div>
                        {{ _self.color(info.bg_color) }}
                    </div>
                    <div>
                        {{ _self.color(info.text_color) }}
                    </div>
                </div>
                <div class="divider my-8 text-lg text-current/75">{{ __('or') }}</div>
                {{ m.file(cover) }}
            </div>
        </div>
    </fieldset>
</form>
