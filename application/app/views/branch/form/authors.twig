{% import 'common/macro/formmacro.twig' as m %}
<div class="grid md:grid-cols-3 gap-4">
    <div>
        <form id="{{ form.id }}" action="{{ form.action }}" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
            <fieldset class="fieldset">
                {{ m.select(master) }}
                {% if invites is defined %}
                    <div>
                        <legend class="fieldset-legend">
                            {{ __('Guest authors') }}
                        </legend>
                        <table class="table">
                            <thead>
                                <tr class="overflow-hidden">
                                    <th class="text-end px-2">{{ __('Author') }}</th>                                
                                    <th class="text-end px-0">{{ __('Moderator') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for k, invite in invites %}
                                {% if invite is iterable and k matches '/^\\d+$/' %}
                                <tr class="overflow-hidden">
                                    <td class="ps-0 pe-2">
                                        {{ m.checkbox(invite) }}
                                    </td>
                                    <td class="ps-2 pe-0 text-end">
                                        <label class="fieldset_label">
                                            <input name="moderator[]" id="{{ 'moder' ~ invite.value }}" type="checkbox"
                                            class="checkbox" value="{{ invite.value }}"
                                            {% if invite.value in moders %}
                                            checked
                                            {% endif %}
                                            />
                                        </label>
                                        <label class="fieldset-label invisible">
                                            <span class="label-text-alt text-error">ok</span>
                                        </label>
                                    </td>
                                </tr>
                                {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </fieldset>
        </form>
    </div>
    <div class="md:col-span-2">
        {{ include('common/author_group_filter.twig') }}
        <div class="divider my-1"></div>
        {% for author in authors %}
        <a href="{{ app.request.rpQuery('remove', 'invite', author.id) }}" class="btn btn-ghost btn-sm mx-1">
            {{ author.alias }}
        </a>
        {% endfor %}
    </div>
</div>
