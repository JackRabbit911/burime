{% extends 'common/layout.twig' %}
{% block content %}
<div class="flex flex-row justify-center">
    <div class="w-full md:w-2xl lg:w-4xl bg-base-100 p-4">
        {% block top %}
        <h1 class="text-2xl mt-2 mb-3">
            {{ title }}
        </h1>
        {{ include('branch/create/step.twig') }}
        {% endblock top %}
        {% block center %}
        {{ form|raw }}
        {% endblock center %}
        {% block bottom %}
        {{ include(controls ?? 'branch/create/form_controls.twig') }}
        {% endblock bottom %}
    </div>
</div>
{% endblock content %}
