{% macro step(form_id, step, action, st) %}
{% if step >= st %}
<li class="step step-primary dark:step-info">
    <button name="sbmt" form="{{ form_id }}" class="btn btn-link" value="{{ action }}">
        {{ __(action|capitalize) }}
    </button>
</li>
{% else %}
<li class="step">
    <button name="sbmt" form="{{ form_id }}" class="btn btn-link" value="{{ action }}">
        {{ __(action|capitalize) }}
    </button>
</li>
{% endif %}
{% endmacro step %}
<ul class="steps w-full my-4">
    {{ _self.step(form.form.id, step, 'genres', 1) }}
    {{ _self.step(form.form.id, step, 'rules', 2) }}
    {{ _self.step(form.form.id, step, 'authors', 3) }}
    {{ _self.step(form.form.id, step, 'cover', 4) }}
    {{ _self.step(form.form.id, step, 'publish', 5) }}
</ul>
