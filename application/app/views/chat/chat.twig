{% embed 'common/embed/top-xl.twig' %}
{% block top %}
<h1 class="text-2xl">
    {{ __(title) }}
</h1>
{% endblock top %}
{% block center %}
<div class="flex flex-col pt-2">
    <div id="messages" class="flex flex-col pt-2">
        <div class="chat chat-start">
            <div class="chat-bubble chat-bubble-primary">
                It's over Anakin\nI have the high ground.
            </div>
        </div>
        <div class="chat chat-end">
            <div class="chat-bubble chat-bubble-accent">
                You underestimate my power!
            </div>
        </div>
    </div>
    <form id="message-form" action="/chat/post/{{ room_id }}/{{ author_id }}" method="post" class="mt-4">
        <textarea id="message-input" name="message" class="textarea w-full" placeholder="Your message"></textarea>
        <div class="flex flex-row-reverse">
            <button type="submit" class="btn btn-primary mt-2">{{ __('Send') }}</button>
        </div>
    </form>
</div>
{% endblock center %}
{% block bottom %}
textarea
{% endblock bottom %}
{% endembed %}
