{% import 'web/home/book_card.twig' as b %}
{% if branch %}
    <div class="grid grid-2 md:grid-cols-3 gap-4">
        <a href="{{ path('branch', {'branch_id': branch.id}) }}" target="_blank">
            {{ b.book(branch) }}
        </a>
        <div class="md:col-span-2 prose flex flex-col justify-between">
            {{ msg.data.body|raw }}
            <p class="text-sm mt-3">
                {{ __('Best regards, ') ~ msg.alias }}
            </p>
        </div>
    </div>
{% else %}
<p class="text-error">
    {{ __('The branch may have been deleted') }}
</p>
{% endif %}
