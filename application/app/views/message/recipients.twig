{% embed 'common/embed/top-xl.twig' %}
{% block top %}
<h1 class="text-2xl">
    {{ __(title) }}
</h1>
{% endblock top %}
{% block center %}
<div class="grid md:grid-cols-3 gap-4 pt-2">
    <div class="overflow-x-auto">
        <h4 class="my-3.5">Recipients</h4>
        <table class="table">
            <tbody>
                {% for recipient in recipients %}
                <tr>
                    <td class="py-2">
                        <a href="{{ app.request.rpQuery('to', 'remove', recipient.id) }}">
                            <div class="flex items-center gap-3">
                                <div class="avatar">
                                    <div class="mask mask-squircle h-10 w-10">
                                        <img src="{{ app.avatar(recipient.id) }}" alt="{{ recipient.alias }}" />
                                    </div>
                                </div>
                                <div>
                                    <div class="font-bold">{{ recipient.alias }}</div>
                                </div>
                            </div>
                        </a>
                    </td>
                </tr>                       
                {% endfor %}                    
            </tbody>
        </table>
        <a href="{{ path('message', {'action': 'form'}) }}"
        class="btn btn-primary mt-2"{% if recipients is empty %} disabled{% endif %}>
            {{ __('New message') }}
        </a>
    </div>
    <div class="md:col-span-2">
        {{ include('common/author_group_filter.twig') }}
        {% for author in authors %}
        <a href="{{ app.request.rpQuery('remove', 'to', author.id) }}" class="btn btn-ghost btn-sm mx-1">
            {{ author.alias }}
        </a>
        {% endfor %}
    </div>
</div>
{% endblock center %}
{% endembed %}
