{% macro book(book) %}
{% set bg_color = book.info.bg_color ?? '#eeeeee' %}
{% set text_color = book.info.text_color ?? '#333333' %}
{% set style_bg_color = 'style="background-color: ' ~  bg_color ~ ';"' %}
{% set style_color = 'style="color: ' ~  text_color ~ ';"' %}
{% set title_size = book.info.text_size ?? 12 %}
{% set style_title_size = 'style="font-size: ' ~  title_size ~ 'cqw;"' %}

{% if book.info.bg_img is defined and book.info.bg_img %}
{% set style_bg_img = 'style="backgroundImage: url(' ~ book.info.bg_img ~ ');"' %}
{% endif %}


<div
    class="relative border border-neutral-content bg-cover aspect-2/3 book-cover inline-size"
    data-title-size="{{ title_size }}"
>
    <div
        class="absolute top-0 left-0 w-full h-full"
        {{ style_bg_color|raw }}
    ></div>

    {% if book.info.bg_img is defined and book.info.bg_img %}
    <div class="absolute top-0 left-0 w-full h-full z-10 bg-cover bg-center"
        {{ style_bg_img|raw }}
    ></div>
    {% endif %}

    <div class="flex flex-col justify-between text-center shadow overflow-hidden w-full h-full"
        {{ style_color|raw }}
    >
        <div class="flex-none overflow-hidden p-1 z-20" style="font-size: 6cqw;">
            {{ book.alias ?? book.master.alias }}
        </div>
        <div class="overflow-hidden p-1 z-20 book-title" {{ style_title_size|raw }}>
            {{ book.title }}
        </div>
        <div class="text-[10%] flex-none overflow-hidden p-1 z-20" style="font-size: 5cqw;">
            {{ book.genreStr }}
        </div>
    </div>

    {% if book.info.cover is defined and book.info.cover %}
    <div class="absolute top-0 left-0 w-full h-full z-30">
        <img src="{{ '/img/cover/' ~ book.cover }}" alt="{{ book.title }}" />
    </div>
    {% endif %}
</div>
{% endmacro %}
