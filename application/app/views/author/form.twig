{% import 'common/macro/formmacro.twig' as m %}
<form id="{{ form.id }}" method="post" action="{{ form.action }}" accept-charset="UTF-8" enctype="multipart/form-data">
    <fieldset class="fieldset w-full px-2">
        {{ csrf()|raw }}
        {{ m.input(alias) }}
        {{ m.textarea(info.slogan) }}
        {{ m.textarea(info.info) }}
        {{ m.file(avatar) }}
        {{ m.select(openclosed) }}
        {% if member.options is not empty %}
            {{ m.select(member) }}
        {% endif %}
        <button type="submit" class="btn btn-primary">{{ __('Save') }}</button>
    </fieldset>
</form>
